APP_NAME=LLM API Gateway
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# Provider credentials are optional; the app and the mock provider work without them.
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Gateway API-key authentication. Leave empty to start with no usable credentials.
# API_KEY_PEPPER: random secret of at least 32 characters, used to HMAC-hash API keys.
# API_KEY_HASHES: comma-separated client_id:key_id:key_hash entries from `gateway-create-key`.
API_KEY_PEPPER=
API_KEY_HASHES=

# Reliability: per-attempt provider timeout and retries for transient provider failures.
PROVIDER_TIMEOUT_SECONDS=30
MAX_RETRIES=2
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=4

# Rate limiting per authenticated client (token bucket, in-memory, per process).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
