APP_NAME=LLM API Gateway
APP_VERSION=0.1.0
# development enables /docs and open /metrics; anything else (e.g. production) disables them.
APP_ENV=development
# DEBUG, INFO, WARNING, ERROR, or CRITICAL. Logs are JSON lines on stdout.
LOG_LEVEL=INFO

# Comma-separated Host header allowlist (supports *.example.com). Loopback is always allowed.
TRUSTED_HOSTS=localhost,127.0.0.1
# Comma-separated explicit browser origins; leave empty to keep CORS disabled.
CORS_ORIGINS=
# Bearer token (32+ random characters) required by GET /metrics. Required for /metrics
# outside development.
METRICS_TOKEN=

# Provider credentials are optional; the app and the mock provider work without them.
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Gateway API-key authentication. Random secret of at least 32 characters used to HMAC-hash
# API keys. Leave empty and no stored key can be verified. Create keys with `gateway-create-key`.
API_KEY_PEPPER=

# SQLite database for API keys, usage records, and the response cache (relative to the
# working directory). The parent directory is created on startup.
DATABASE_URL=sqlite:///./data/gateway.db

# Response cache: off by default; only requests with temperature 0 are ever cached.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000

# Reliability: per-attempt provider timeout and retries for transient provider failures.
PROVIDER_TIMEOUT_SECONDS=30
MAX_RETRIES=2
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=4

# Rate limiting per authenticated client (token bucket, in-memory, per process).
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
